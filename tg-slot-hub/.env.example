# apps/api, apps/bot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
JWT_SECRET=change-me-32-bytes-minimum
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tgslot
API_PORT=8787
# apps/hub (Vite)
VITE_API_URL=http://localhost:8787
# 개발 모드: 텔레그램 밖에서 열었을 때 mock initData 사용 (프로덕션에서는 반드시 false)
VITE_DEV_MOCK_TMA=true
API_ALLOW_DEV_MOCK=true
# 미니앱 공개 URL (봇 메뉴 버튼 / BotFather 등록용)
MINI_APP_URL=https://your-hub.vercel.app
